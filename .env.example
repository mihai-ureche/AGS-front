# Public configuration only. Never put a client secret in a VITE_ variable.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
# Optional: defaults to the current web origin followed by /.
VITE_MICROSOFT_REDIRECT_URI=
# Register as a Mobile and desktop application redirect URI in Entra.
VITE_MICROSOFT_NATIVE_REDIRECT_URI=com.ags.insights://oauth/redirect
# Demo uses bundled sample data. Disable to remove the demo entry point.
VITE_ENABLE_DEMO=true
